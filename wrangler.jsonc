{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ejustai",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/health",
			"/ask",
			"/history",
			"/clear",
			"/feedback",
			"/profile",
			"/title",
			"/api/*"
		]
	},
	"vars": {
		"NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
		"NVIDIA_CHAT_MODEL": "nvidia/nemotron-3.5-bolt-e4b",
		"NVIDIA_EMBED_MODEL": "nvidia/embed-qa-4",
		"RAG_TOP_K": "5",
		"RAG_MIN_SCORE": "0.22"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "ejustai-index",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ejustai-db",
			"database_id": "fb2e82d8-fe21-4d54-b9f9-a068e131e05d",
			"migrations_dir": "migrations",
			"remote": true
		}
	]
}